rules_version = '2';

// CampusFind is server-only: every read and write goes through the Express app using the
// Firebase Admin SDK, which bypasses these rules. Denying all client access means a leaked
// web API key or a browser console cannot read or change any data.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
