# Copy to .env for a VM or local run, or set these as secrets on Cloud Run / Replit. Never commit real values.
# Real environment variables always override this file.

# ---- Firebase (Hosting, Auth, Storage) ----
FIREBASE_PROJECT_ID=your-project-id
# General tab > Web API Key. Used only for password sign-in and reset-email calls.
FIREBASE_WEB_API_KEY=
# (On Cloud Functions, where names starting with FIREBASE_ are reserved, use WEB_API_KEY instead.)
# Storage page shows the bucket name, e.g. your-project-id.firebasestorage.app (REQUIRED in production)
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Service accounts tab > Generate new private key. Paste the JSON on ONE line or base64-encode it.
# Leave empty on Cloud Functions / Cloud Run: the runtime service account is used automatically.
FIREBASE_SERVICE_ACCOUNT=

# ---- App ----
NODE_ENV=production
PORT=8080
# Public address of the site (used in link previews). Must be https:// in production.
# On Firebase Hosting this is usually https://YOUR_PROJECT.web.app
BASE_URL=https://your-project.web.app

# First-run super admin. If ADMIN_PASSWORD is empty a random one is printed once in the server log.
ADMIN_EMAIL=admin@yourcampus.edu
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

# Restrict sign-ups to campus email domains (comma separated). Empty = any email.
ALLOWED_EMAIL_DOMAINS=
CAMPUS_NAME=your campus
# Set to false to require sign-in even to browse
PUBLIC_BROWSING=true

# ---- Legal pages (shown in the Terms, Privacy and other legal documents) ----
# Name of the organisation operating the site, e.g. "Example University Student Union"
LEGAL_ENTITY=
# Where members send privacy requests, appeals and takedown notices
CONTACT_EMAIL=
# Public support mailbox shown on the legal and help pages. Use a business address, not a personal one.
# Leave empty to point people to the Help centre chat only.
SUPPORT_EMAIL=
# Jurisdiction for the governing-law clause, e.g. "Kenya" or "England and Wales"
GOVERNING_LAW=

# ---- Optional tuning ----
# Cookie name. Production default is "__session", the only cookie Firebase Hosting forwards to Cloud Run.
# SESSION_COOKIE_NAME=
# GLOBAL_LIMIT_PER_MIN=300
# REGISTER_LIMIT_PER_HOUR=8
# LOGIN_LIMIT_PER_15_MIN=20
# TRUST_PROXY=1

# Minimum age to register (default 16, never below 13). Raise it where the local age of digital consent is higher.
MIN_AGE=16
# Operator's postal address. Shown in the footer and legal pages; required in any marketing email.
POSTAL_ADDRESS=
# US DMCA designated agent, registered at https://dmca.copyright.gov/ (about $6, renew every 3 years)
DMCA_AGENT_NAME=
DMCA_AGENT_EMAIL=
DMCA_AGENT_ADDRESS=
DMCA_REGISTRATION_NO=

# Where listing photos are kept: storage (Firebase Storage, needs Blaze) or firestore (free Spark plan)
PHOTO_STORE=storage

# AI assistant (optional). Create a key at https://console.anthropic.com/ ; leave empty to keep the assistant off.
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-haiku-5-5
# ASSISTANT_PER_HOUR=20
# ASSISTANT_PER_DAY=60
# MESSAGES_PER_MIN=6
# MESSAGES_PER_DAY=80

# Paid promotions. Leave PAYSTACK_SECRET_KEY empty to take payments manually (Mobile Money) and confirm them in Admin > Orders.
# Get the key at https://dashboard.paystack.com/#/settings/developers (use the test key first).
PAYSTACK_SECRET_KEY=
# Shown to members who order without online payment, e.g. "Send Mobile Money to 024 XXX XXXX (CampusFind). Use the order number as the reference."
MANUAL_PAYMENT_INSTRUCTIONS=
# The Mobile Money account members pay into (shown only on a member's own order page)
MOMO_NUMBER=
MOMO_NAME=
MOMO_NETWORK=
# Prices in cedis and the length of the business products in days
# PRICE_FEATURED=10
# PRICE_BUSINESS=50
# PRICE_PREMIUM=100
# BUSINESS_DAYS=30

# Extra university email domains that earn the "Verified student" badge (comma separated). *.edu.gh always counts.
STUDENT_DOMAINS=

# Staff two-step sign-in (authenticator app). On by default in production; set STAFF_2FA=off only in an emergency.
STAFF_2FA=
# Emergency only: if the owner loses their phone AND recovery codes, set this to their email, open the site once,
# then DELETE the variable and redeploy. It switches off two-step sign-in for that one account so it can be set up again.
STAFF_2FA_RESET_EMAIL=
# Optional: key that encrypts authenticator secrets. If empty, a key is derived from FIREBASE_SERVICE_ACCOUNT
# (rotating that service account key then means staff must set up two-step sign-in again).
TOTP_ENCRYPTION_KEY=
